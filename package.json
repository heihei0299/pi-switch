{
  "name": "@heihei0299/pi-switch",
  "version": "20260831.1.0",
  "description": "Lightweight profile switcher for pi models.json",
  "type": "module",
  "bin": {
    "pi-switch": "./bin/pi-switch.js"
  },
  "main": "./index.js",
  "files": [
    "bin/",
    "webui/dist/",
    "index.js",
    "index.d.ts",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "build": "npm run build:webui && npm run build:go",
    "build:webui": "npm --prefix webui install && npm --prefix webui run build",
    "build:go": "go build -ldflags \"-s -w\" -o bin/pi-switch ./cmd/pi-switch",
    "build:all": "bash scripts/build-all.sh",
    "build:go:current": "go build -ldflags \"-s -w\" -o bin/pi-switch-$(go env GOOS)-$(go env GOARCH) ./cmd/pi-switch",
    "dev:webui": "npm --prefix webui run dev",
    "doctor": "node ./bin/pi-switch.js doctor",
    "test": "go test ./...",
    "test:webui": "NODE_ENV=test npx --prefix webui vitest run"
  },
  "keywords": [
    "pi",
    "pi-package",
    "models",
    "switch"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "license": "MIT",
  "engines": {
    "node": ">=23.6"
  }
}
