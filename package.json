{
  "name": "@heihei0299/pi-switch",
  "version": "20261011.0.0",
  "description": "Lightweight profile switcher for pi models.json",
  "type": "module",
  "bin": {
    "pi-switch": "./bin/pi-switch.js"
  },
  "files": [
    "bin/",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "build": "npm run build:go",
    "build:go": "bash scripts/build-go.sh bin/pi-switch",
    "build:all": "bash scripts/build-all.sh",
    "build:go:current": "bash scripts/build-go.sh bin/pi-switch-$(go env GOOS)-$(go env GOARCH)",
    "doctor": "node ./bin/pi-switch.js doctor",
    "test": "go test -p 1 -parallel 2 ./..."
  },
  "keywords": [
    "pi",
    "pi-package",
    "models",
    "switch"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=23.6"
  }
}
