# Scratch issue tracker: keep canonical records versioned while ignoring
# local audits, logs, patches, screenshots and other generated artifacts.
.scratch/**
!.scratch/
!.scratch/*.md
!.scratch/*/
!.scratch/*/spec.md
!.scratch/*/issues/
!.scratch/*/issues/*.md
!.scratch/*/map.md
.gocache/
# template-sync backups (e.g. AGENTS.md.bak)
*.bak

# Archived scratch notes retain the original local-only/versioned boundary.
archive/scratch/**
!archive/scratch/
!archive/scratch/*/
!archive/scratch/*/issues/
!archive/scratch/*/issues/*.md
!archive/scratch/*/map.md
/webui/dist/
/tmp/
