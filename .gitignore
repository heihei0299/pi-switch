node_modules/
target/
*.node
*.tar.gz
*.tgz
.env
.vscode/
*.log
pi-session-*.html
*claude*cli*.txt

# Go binaries (built via go build, cross-compile) - only top-level and bin
/bin/pi-switch
/bin/pi-switch.exe
bin/pi-switch
bin/pi-switch-*

# webui build artifacts (dist is embedded into the Go binary at build time)
webui/node_modules/
webui/dist/*
!webui/dist/.gitkeep

# agent tooling config & local caches
.mcp.json
opencode.jsonc
.claude/
.opencode/
.codegraph/
.cortexkit/
.agents/
.pi/
# Scratch issue tracker: keep canonical records versioned while ignoring
# local audits, logs, patches, screenshots and other generated artifacts.
.scratch/**
!.scratch/
!.scratch/*/
!.scratch/*/spec.md
!.scratch/*/issues/
!.scratch/*/issues/*.md
!.scratch/*/map.md
.gocache/
# template-sync backups (e.g. AGENTS.md.bak)
*.bak
